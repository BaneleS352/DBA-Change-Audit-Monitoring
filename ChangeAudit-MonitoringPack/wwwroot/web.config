<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
  <defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument>
  <staticContent><remove fileExtension=".json"/><mimeMap fileExtension=".json" mimeType="application/json"/></staticContent>
  <httpProtocol><customHeaders>
    <add name="X-Content-Type-Options" value="nosniff"/>
    <add name="Cache-Control" value="no-store"/>
    <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"/>
  </customHeaders></httpProtocol>
</system.webServer></configuration>
